# Install privately as /etc/afterclass-monitor.env (root-owned, mode 600).
# Use an INDEPENDENT host with Node 22+; localhost would test the monitor itself.
AFTERCLASS_HEALTH_URL=https://afterclass.neuralagent.dev/health
HEALTH_SECRET=replace-with-api-health-secret
RESEND_API_KEY=replace-with-restricted-sending-key
RESEND_FROM=Afterclass Operations <verify@neuralagent.dev>
OPERATIONS_ALERT_EMAIL=codingtocreation@gmail.com

