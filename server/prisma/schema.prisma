generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CampusStatus {
  active
  paused
  retired
}

enum AccountStatus {
  active
  muted
  suspended
  banned
}

enum Gender {
  woman
  man
  nonbinary
  self_described
  prefer_not_to_say
}

enum Orientation {
  straight
  gay
  lesbian
  bisexual
  pansexual
  queer
  questioning
  asexual
  prefer_not_to_say
}

enum AliasRotationReason {
  initial
  scheduled
  outing_completed
  moderation
}

enum RoomKind {
  campus
  match
}

enum MatchRequestStatus {
  open
  pending_acceptance
  matched
  completed
  expired
  cancelled
}

enum ApplicationStatus {
  pending
  accepted
  waiting
  withdrawn
  expired
}

enum MatchStatus {
  active
  completed
  cancelled
}

enum RevealStatus {
  pending
  accepted
  declined
}

enum ReportReason {
  harassment
  inappropriate_content
  spam
  threats
  impersonation
  other
}

enum ReportStatus {
  pending
  reviewing
  resolved
  dismissed
}

enum ModerationActionType {
  warning
  mute
  suspension
  ban
}

model Campus {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  name        String
  emailDomain String       @unique @map("email_domain")
  location    String?
  status      CampusStatus @default(active)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  users       User[]
  rooms       ChatRoom[]
  requests    MatchRequest[]
  reports     Report[]
  actions     ModerationAction[]
  hearingSlots HearingSlot[]

  @@map("campuses")
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  campusId       String        @map("campus_id") @db.Uuid
  email          String        @unique
  publicAlias    String        @map("public_alias")
  revealName     String?       @map("reveal_name")
  gender         Gender        @default(prefer_not_to_say)
  orientation    Orientation   @default(prefer_not_to_say)
  genderPreference String      @default("any") @map("gender_preference")
  reputationScore Int          @default(100) @map("reputation_score")
  noShowCount    Int           @default(0) @map("no_show_count")
  accountStatus  AccountStatus @default(active) @map("account_status")
  suspendedUntil DateTime?     @map("suspended_until") @db.Timestamptz(6)
  sessionVersion Int           @default(0) @map("session_version")
  avatarConfig   Json?         @map("avatar_config")
  verificationStatus String       @default("unverified") @map("verification_status")
  isVerified         Boolean      @default(false) @map("is_verified")
  genderLocked       Boolean      @default(false) @map("gender_locked")
  verificationGesture String?     @map("verification_gesture") @db.VarChar(50)
  verificationPhoto  String?      @map("verification_photo") @db.VarChar(255)
  verificationSubmittedAt DateTime? @map("verification_submitted_at") @db.Timestamptz(6)
  verifiedAt         DateTime?    @map("verified_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActiveAt   DateTime      @default(now()) @map("last_active_at") @db.Timestamptz(6)
  campus         Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  connectionProfile ConnectionProfile?
  blocksMade UserBlock[] @relation("blocker")
  blocksReceived UserBlock[] @relation("blocked")
  meetingFeedback MeetingFeedback[]
  verificationAppeals VerificationAppeal[] @relation("appeal_owner")
  reviewedAppeals VerificationAppeal[] @relation("appeal_reviewer")
  aliases        AliasHistory[]
  sentMessages   Message[]
  createdRequests MatchRequest[] @relation("requester")
  applications   MatchApplication[]
  firstMatches   Match[]       @relation("match_user_one")
  secondMatches  Match[]       @relation("match_user_two")
  revealConsents RevealConsent[]
  reportsFiled   Report[]      @relation("reporter")
  reportsReceived Report[]     @relation("reported_user")
  accountReviews AccountReview[] @relation("review_owner")
  assignedReviews AccountReview[] @relation("review_staff")
  moderationActions ModerationAction[] @relation("action_target")
  administeredActions ModerationAction[] @relation("action_admin")
  hearingSlots HearingSlot[]
  chairedHearings Hearing[]
  hearingParticipation HearingParticipant[]
  hearingMessages HearingMessage[]

  @@unique([campusId, publicAlias])
  @@index([campusId, accountStatus])
  @@map("users")
}

model AliasHistory {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  alias          String
  rotationReason AliasRotationReason @map("rotation_reason")
  startedAt      DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?           @map("ended_at") @db.Timestamptz(6)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("alias_history")
}

model ChatRoom {
  id        String   @id @default(uuid()) @db.Uuid
  campusId  String   @map("campus_id") @db.Uuid
  kind      RoomKind
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Restrict)
  messages  Message[]
  match     Match?

  @@index([campusId, kind])
  @@map("chat_rooms")
}

model Message {
  id          String    @id @default(uuid()) @db.Uuid
  roomId      String    @map("room_id") @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  senderAlias String    @map("sender_alias")
  content     String    @db.VarChar(500)
  isFiltered  Boolean   @default(false) @map("is_filtered")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  room        ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Restrict)
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  reports     Report[]

  @@index([roomId, createdAt])
  @@index([senderId, createdAt])
  @@index([expiresAt])
  @@map("messages")
}

model MatchRequest {
  id                    String             @id @default(uuid()) @db.Uuid
  campusId              String             @map("campus_id") @db.Uuid
  requesterId           String             @map("requester_id") @db.Uuid
  connectionMode        String             @default("social") @map("connection_mode")
  activity              String             @db.VarChar(100)
  location              String             @db.VarChar(120)
  scheduledAt           DateTime           @map("scheduled_at") @db.Timestamptz(6)
  genderPreference      String             @default("any") @map("gender_preference")
  orientationPreference String             @default("any") @map("orientation_preference")
  status                MatchRequestStatus @default(open)
  expiresAt             DateTime           @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  campus                Campus             @relation(fields: [campusId], references: [id], onDelete: Restrict)
  requester             User               @relation("requester", fields: [requesterId], references: [id], onDelete: Restrict)
  applications          MatchApplication[]
  match                 Match?

  @@index([campusId, status, expiresAt])
  @@index([requesterId, status])
  @@map("match_requests")
}

model MatchApplication {
  id          String            @id @default(uuid()) @db.Uuid
  requestId   String            @map("request_id") @db.Uuid
  applicantId String            @map("applicant_id") @db.Uuid
  status      ApplicationStatus @default(pending)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  request     MatchRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  applicant   User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([requestId, applicantId])
  @@index([applicantId, status])
  @@map("match_applications")
}

model Match {
  id               String          @id @default(uuid()) @db.Uuid
  requestId        String          @unique @map("request_id") @db.Uuid
  userOneId        String          @map("user_one_id") @db.Uuid
  userTwoId        String          @map("user_two_id") @db.Uuid
  roomId           String          @unique @map("room_id") @db.Uuid
  status           MatchStatus     @default(active)
  confirmedOneAt DateTime? @map("confirmed_one_at") @db.Timestamptz(6)
  confirmedTwoAt DateTime? @map("confirmed_two_at") @db.Timestamptz(6)
  proposedAt DateTime? @map("proposed_at") @db.Timestamptz(6)
  proposedById String? @map("proposed_by_id") @db.Uuid
  proposedLocation String? @map("proposed_location") @db.VarChar(120)
  revision Int @default(0)
  feedback MeetingFeedback[]
  disappearingMode Boolean         @default(false) @map("disappearing_mode")
  scheduledAt      DateTime        @map("scheduled_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(6)
  request          MatchRequest    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  userOne          User            @relation("match_user_one", fields: [userOneId], references: [id], onDelete: Restrict)
  userTwo          User            @relation("match_user_two", fields: [userTwoId], references: [id], onDelete: Restrict)
  room             ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  revealConsents   RevealConsent[]

  @@index([userOneId, status])
  @@index([userTwoId, status])
  @@map("matches")
}

model RevealConsent {
  id          String       @id @default(uuid()) @db.Uuid
  matchId     String       @map("match_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  status      RevealStatus @default(pending)
  requestedAt DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  respondedAt DateTime?    @map("responded_at") @db.Timestamptz(6)
  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@map("reveal_consents")
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  campusId       String       @map("campus_id") @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  reportedUserId String       @map("reported_user_id") @db.Uuid
  messageId      String?      @map("message_id") @db.Uuid
  reason         ReportReason
  detail         String?      @db.VarChar(1000)
  status         ReportStatus @default(pending)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(6)
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Restrict)
  reporter       User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reportedUser   User         @relation("reported_user", fields: [reportedUserId], references: [id], onDelete: Restrict)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([campusId, status, createdAt])
  @@index([reportedUserId, createdAt])
  @@map("reports")
}

model ModerationAction {
  id          String               @id @default(uuid()) @db.Uuid
  campusId    String               @map("campus_id") @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  adminUserId String?              @map("admin_user_id") @db.Uuid
  type        ModerationActionType
  reason      String               @db.VarChar(1000)
  publicSummary String? @map("public_summary") @db.VarChar(1000)
  policy String? @db.VarChar(100)
  evidence Json? // Staff-only snapshot; never serialized to the appellant.
  liftedAt DateTime? @map("lifted_at") @db.Timestamptz(6)
  review AccountReview?
  startsAt    DateTime             @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime?            @map("ends_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  campus      Campus               @relation(fields: [campusId], references: [id], onDelete: Restrict)
  user        User                 @relation("action_target", fields: [userId], references: [id], onDelete: Restrict)
  adminUser   User?                @relation("action_admin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
  @@index([campusId, createdAt])
  @@map("moderation_actions")
}

// Birth date and preferences are private. Only adult age is serialized for dating.
model ConnectionProfile {
  userId String @id @map("user_id") @db.Uuid
  bio String @default("") @db.VarChar(240)
  interests String[] @default([])
  prompt String @default("") @db.VarChar(100)
  answer String @default("") @db.VarChar(200)
  birthDate DateTime? @map("birth_date") @db.Date
  datingEnabled Boolean @default(false) @map("dating_enabled")
  datingIntent String @default("relationship") @map("dating_intent")
  minAge Int @default(18) @map("min_age")
  maxAge Int @default(30) @map("max_age")
  availableUntil DateTime? @map("available_until") @db.Timestamptz(6)
  availabilityActivity String @default("coffee") @map("availability_activity") @db.VarChar(30)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([availableUntil])
  @@map("connection_profiles")
}
model UserBlock {
  blockerId String @map("blocker_id") @db.Uuid
  blockedId String @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}
model MeetingFeedback {
  id String @id @default(uuid()) @db.Uuid
  matchId String @map("match_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  outcome String @db.VarChar(30)
  note String @default("") @db.VarChar(400)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([matchId, userId])
  @@map("meeting_feedback")
}
model VerificationAppeal {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  reason String @db.VarChar(1000)
  status String @default("pending") @db.VarChar(30)
  response String? @db.VarChar(1000)
  reviewerId String? @map("reviewer_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  user User @relation("appeal_owner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("appeal_reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  @@index([userId, status])
  @@map("verification_appeals")
}

model AccountReview {
  id String @id @default(uuid()) @db.Uuid
  actionId String @unique @map("action_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  reviewerId String? @map("reviewer_id") @db.Uuid
  status String @default("submitted") @db.VarChar(30)
  outcome String? @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  reopenedAt DateTime? @map("reopened_at") @db.Timestamptz(6)
  action ModerationAction @relation(fields: [actionId], references: [id], onDelete: Restrict)
  user User @relation("review_owner", fields: [userId], references: [id], onDelete: Restrict)
  reviewer User? @relation("review_staff", fields: [reviewerId], references: [id], onDelete: SetNull)
  hearing Hearing?
  entries ReviewEntry[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("account_reviews")
}
model ReviewEntry {
  id String @id @default(uuid()) @db.Uuid
  reviewId String @map("review_id") @db.Uuid
  kind String @db.VarChar(30)
  body String @db.VarChar(4000)
  attachments Json @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  review AccountReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  @@index([reviewId, createdAt])
  @@map("review_entries")
}

model HearingSlot {
  id String @id @default(uuid()) @db.Uuid
  campusId String @map("campus_id") @db.Uuid
  judgeId String @map("judge_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  hearing Hearing?
  campus Campus @relation(fields:[campusId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  judge User @relation(fields:[judgeId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  @@index([campusId, startsAt])
  @@index([judgeId, startsAt])
  @@map("hearing_slots")
}
model Hearing {
  id String @id @default(uuid()) @db.Uuid
  reviewId String @unique @map("review_id") @db.Uuid
  slotId String? @unique @map("slot_id") @db.Uuid
  judgeId String @map("judge_id") @db.Uuid
  status String @default("scheduled") @db.VarChar(20)
  floor String @default("appellant") @db.VarChar(40)
  judgeLastSeenAt DateTime? @map("judge_last_seen_at") @db.Timestamptz(6)
  startedAt DateTime? @map("started_at") @db.Timestamptz(6)
  deadline DateTime? @db.Timestamptz(6)
  endedAt DateTime? @map("ended_at") @db.Timestamptz(6)
  endReason String? @map("end_reason") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  judge User @relation(fields:[judgeId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  review AccountReview @relation(fields:[reviewId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  slot HearingSlot? @relation(fields:[slotId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  participants HearingParticipant[]
  messages HearingMessage[]
  @@index([judgeId, status])
  @@map("hearings")
}
model HearingParticipant {
  id String @id @default(uuid()) @db.Uuid
  hearingId String @map("hearing_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role String @db.VarChar(20)
  label String @db.VarChar(40)
  response String @default("invited") @db.VarChar(20)
  speakRequestedAt DateTime? @map("speak_requested_at") @db.Timestamptz(6)
  speakRequestKind String? @map("speak_request_kind") @db.VarChar(20)
  speakRequestedLastAt DateTime? @map("speak_requested_last_at") @db.Timestamptz(6)
  joinedAt DateTime? @map("joined_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  hearing Hearing @relation(fields:[hearingId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  @@unique([hearingId,userId],map:"hearing_participants_hearing_id_user_id_key")
  @@index([userId,response])
  @@map("hearing_participants")
}
model HearingMessage {
  id String @id @default(uuid()) @db.Uuid
  hearingId String @map("hearing_id") @db.Uuid
  authorId String? @map("author_id") @db.Uuid
  label String @db.VarChar(40)
  visibility String @default("shared") @db.VarChar(20)
  body String @db.VarChar(4000)
  attachments Json @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  hearing Hearing @relation(fields:[hearingId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  author User? @relation(fields:[authorId],references:[id],onDelete:SetNull,onUpdate:NoAction)
  @@index([hearingId,createdAt])
  @@map("hearing_messages")
}
