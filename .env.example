NODE_ENV=development
PORT=3002
CLIENT_URL=http://localhost:5173
# Vite development only; deployed builds use same-origin /api.
VITE_API_URL=http://localhost:3002/api

# Generate a long unique value for every environment. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_KEY=replace-with-a-separate-long-random-secret
ADMIN_EMAILS=
HEALTH_SECRET=replace-with-a-third-long-random-secret
# Separate secret used to hash OTPs before storage.
OTP_PEPPER=replace-with-another-long-random-secret

# University enrollment is managed in Administration → Colleges → Access settings.
UNIVERSITY_DOMAIN=niituniversity.in
# Email-domain rules are stored in PostgreSQL; CAMPUSES_JSON is no longer used.

# Local Docker defaults. For Supabase Prisma, use Transaction Pooler (6543) for DATABASE_URL and Session Pooler (5432) for DIRECT_URL.
DATABASE_URL=postgresql://afterclass:local-development-only@localhost:5432/afterclass
DIRECT_URL=postgresql://afterclass:local-development-only@localhost:5432/afterclass
# Local Docker Redis. In production, use the rediss:// connection URL from Upstash.
REDIS_URL=redis://localhost:6379
RESEND_API_KEY=
# Must be an address from a Resend-verified domain, for example: Afterclass <no-reply@example.com>
RESEND_FROM=

# Google OAuth 2.0 Credentials for "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/auth/google/callback

# Production only: exact Vercel URL, then custom domain after it is configured.
# CLIENT_URL=https://your-project.vercel.app


# Required in production: independent random secrets, each at least 32 characters.
# Generate outside source control. Never use these blank values in production.
STAFF_ENCRYPTION_KEY=
# AUTHENTICATOR setup is mandatory for staff outside the isolated review environment.
# ADMIN_EMAILS now bootstraps persistent grants; changing it does not revoke access.
# Use Administration > Moderation > Team to revoke or change roles.
# The current self-declared-age dating implementation is disabled in NODE_ENV=production.
# Configure the following on an independent uptime runner, not the app host:
# AFTERCLASS_HEALTH_URL=https://your-afterclass-domain/health

# Background Web Push (opt-in in Settings → Notifications).
# Generate once with: npx web-push generate-vapid-keys
# Keep the private key server-only. Changing keys requires device re-enrolment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operations@example.com
OPERATIONS_ALERT_EMAIL=

# Independent runner only: use a private env file outside the repository.
# AFTERCLASS_HEALTH_URL=https://your-afterclass-domain/health
# HEALTH_PROBE_STATE=/private/afterclass-monitor/state.json
# RESEND_FROM, RESEND_API_KEY, HEALTH_SECRET and OPERATIONS_ALERT_EMAIL are required there.

# Recovery runner only. Store the encryption key separately from backups.
# BACKUP_DATABASE_URL=postgresql://... direct or session-pooler connection
# BACKUP_ENCRYPTION_KEY=64-hex-characters
