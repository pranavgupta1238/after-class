NODE_ENV=development
PORT=3002
CLIENT_URL=http://localhost:5173
# Vite development only; deployed builds use same-origin /api.
VITE_API_URL=http://localhost:3002/api

# Generate a long unique value for every environment. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_KEY=replace-with-a-separate-long-random-secret
HEALTH_SECRET=replace-with-a-third-long-random-secret
# Separate secret used to hash OTPs before storage.
OTP_PEPPER=replace-with-another-long-random-secret

# NIIT University is the first campus. Add future campuses using CAMPUSES_JSON.
UNIVERSITY_DOMAIN=niituniversity.in
# CAMPUSES_JSON=[{"id":"niit-university","name":"NIIT University","domain":"niituniversity.in","location":"Neemrana, Rajasthan"}]

# Local Docker defaults. For Supabase Prisma, use Transaction Pooler (6543) for DATABASE_URL and Session Pooler (5432) for DIRECT_URL.
DATABASE_URL=postgresql://afterclass:local-development-only@localhost:5432/afterclass
DIRECT_URL=postgresql://afterclass:local-development-only@localhost:5432/afterclass
# Local Docker Redis. In production, use the rediss:// connection URL from Upstash.
REDIS_URL=redis://localhost:6379
RESEND_API_KEY=
# Must be an address from a Resend-verified domain, for example: Afterclass <no-reply@example.com>
RESEND_FROM=

# Production only: exact Vercel URL, then custom domain after it is configured.
# CLIENT_URL=https://your-project.vercel.app
