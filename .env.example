NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Generate a long unique value for every environment. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_KEY=replace-with-a-separate-long-random-secret

# NIIT University is the first campus. Add future campuses using CAMPUSES_JSON.
UNIVERSITY_DOMAIN=niituniversity.in
# CAMPUSES_JSON=[{"id":"niit-university","name":"NIIT University","domain":"niituniversity.in","location":"Neemrana, Rajasthan"}]

# Local Docker defaults; replace DATABASE_URL with the Supabase pooled connection URL in production.
DATABASE_URL=postgresql://afterclass:local-development-only@localhost:5432/afterclass
REDIS_URL=redis://localhost:6379
RESEND_API_KEY=

# Production only: exact Vercel URL, then custom domain after it is configured.
# CLIENT_URL=https://your-project.vercel.app
